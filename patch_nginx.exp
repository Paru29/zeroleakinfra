#!/usr/bin/expect -f
set timeout -1
spawn ssh -o StrictHostKeyChecking=no root@187.127.152.70
expect "password:"
send "REDACTED_PASSWORD\r"
expect "# "
send "cat << 'INNER_EOF' > patch.sh
#!/bin/bash
if ! grep -q 'location /pgadmin/' /etc/nginx/sites-available/zeroleak_track; then
  sed -i '/location \/ {/i \\    location /pgadmin/ {\\n        proxy_pass http://127.0.0.1:5050/;\\n        proxy_set_header X-Script-Name /pgadmin;\\n        proxy_set_header Host \$host;\\n        proxy_set_header X-Real-IP \$remote_addr;\\n        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;\\n        proxy_set_header X-Forwarded-Proto \$scheme;\\n        proxy_redirect off;\\n    }\\n' /etc/nginx/sites-available/zeroleak_track
  nginx -t && systemctl reload nginx
fi
INNER_EOF\r"
expect "# "
send "bash patch.sh\r"
expect "# "
send "exit\r"
