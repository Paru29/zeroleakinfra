#!/usr/bin/expect -f
set timeout 300

puts "Uploading archive..."
spawn scp -o StrictHostKeyChecking=no zeroleak_deploy.tar.gz root@187.127.152.70:/root/
expect {
    "*assword:*" {
        send "REDACTED_PASSWORD\r"
        exp_continue
    }
    eof
}

puts "Executing deployment commands..."
spawn ssh -o StrictHostKeyChecking=no root@187.127.152.70
expect "*assword:*"
send "REDACTED_PASSWORD\r"
expect "*# "

send "mkdir -p /root/zeroleakinfra\r"
expect "*# "

send "tar -xzf /root/zeroleak_deploy.tar.gz -C /root/zeroleakinfra\r"
expect "*# "

send "cd /root/zeroleakinfra\r"
expect "*# "

send "apt-get update && apt-get install -y docker.io docker-compose\r"
expect "*# "

send "docker-compose up -d --build\r"
expect "*# "

send "exit\r"
expect eof
