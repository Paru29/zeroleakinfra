#!/usr/bin/expect -f
set timeout 60

spawn ssh -o StrictHostKeyChecking=no root@187.127.152.70
expect "*assword:*"
send "REDACTED_PASSWORD\r"
expect "*# "

send "cat << 'NGINX_EOF' > /etc/nginx/sites-available/zeroleak_track\r"
send "server {\r"
send "    listen 80;\r"
send "    server_name track.zeroleakinfra.tech;\r"
send "    location / {\r"
send "        proxy_pass http://127.0.0.1:3000;\r"
send "        proxy_set_header Host \\\$host;\r"
send "        proxy_set_header X-Real-IP \\\$remote_addr;\r"
send "        proxy_set_header X-Forwarded-For \\\$proxy_add_x_forwarded_for;\r"
send "        proxy_set_header X-Forwarded-Proto \\\$scheme;\r"
send "    }\r"
send "}\r"
send "NGINX_EOF\r"
expect "*# "

send "ln -sf /etc/nginx/sites-available/zeroleak_track /etc/nginx/sites-enabled/\r"
expect "*# "

send "nginx -t\r"
expect "*# "

send "systemctl restart nginx\r"
expect "*# "

send "certbot --nginx -d track.zeroleakinfra.tech --non-interactive --agree-tos -m admin@zeroleakinfra.tech\r"
expect "*# "

send "exit\r"
expect eof
