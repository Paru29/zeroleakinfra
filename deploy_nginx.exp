#!/usr/bin/expect -f
set timeout 300

spawn ssh -o StrictHostKeyChecking=no root@187.127.152.70
expect "*assword:*"
send "REDACTED_PASSWORD\r"
expect "*# "

send "apt-get install -y nginx\r"
expect "*# "

send "cat << 'NGINX_EOF' > /etc/nginx/sites-available/zeroleak\r"
send "server {\r"
send "    listen 80;\r"
send "    server_name _;\r"
send "    location / {\r"
send "        proxy_pass http://127.0.0.1:3000;\r"
send "        proxy_set_header Host \\\$host;\r"
send "        proxy_set_header X-Real-IP \\\$remote_addr;\r"
send "        proxy_set_header X-Forwarded-For \\\$proxy_add_x_forwarded_for;\r"
send "    }\r"
send "}\r"
send "NGINX_EOF\r"
expect "*# "

send "ln -s /etc/nginx/sites-available/zeroleak /etc/nginx/sites-enabled/\r"
expect "*# "

send "rm /etc/nginx/sites-enabled/default\r"
expect "*# "

send "systemctl restart nginx\r"
expect "*# "

send "exit\r"
expect eof
