#!/usr/bin/expect -f
set timeout 20
spawn ssh root@187.127.152.70 "docker exec -i zeroleak_api node -e \"
const bcrypt = require('bcryptjs');
const db = require('./src/db');
(async () => {
  const hash = await bcrypt.hash('kelmeindia', 10);
  await db('tenants').where('username', 'kelmeindia').update({ password_hash: hash });
  console.log('Password reset successfully');
  process.exit(0);
})();
\""
expect "password:"
send "REDACTED_PASSWORD\r"
expect eof
